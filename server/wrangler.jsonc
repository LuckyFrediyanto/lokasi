{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lacak-hp-server",
  "main": "src/index.js",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LOCATION_HUB",
        "class_name": "LocationHubDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LocationHubDO"]
    }
  ]
}
